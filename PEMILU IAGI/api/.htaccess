# Protect sensitive files and registry from direct download
<FilesMatch "(\.(json|lock|log|csv|bak|sql|env)$|dpt_master_registry\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
