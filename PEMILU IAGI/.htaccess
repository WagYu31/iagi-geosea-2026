# ==============================================================================
# PEMILU IAGI 2026 - PRODUCTION SECURITY HARDENING (.htaccess)
# Compliance: ISO/IEC 27002, ISO/IEC 27017, ISO/IEC 27018
# ==============================================================================

# Disable directory listing
Options -Indexes

# Block direct HTTP access to api/data directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/data(/.*)?$ - [F,L]
</IfModule>

# Protect hidden files and sensitive extensions
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|lock|json)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Enterprise Security Headers (Defense-in-depth)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
