# ==============================================================================
# PEMILU IAGI 2026 - PRODUCTION SECURITY HARDENING (.htaccess)
# Compliance: ISO/IEC 27002, ISO/IEC 27017, ISO/IEC 27018
# ==============================================================================

# Disable directory listing
Options -Indexes

# ==============================================================================
# ANTI-BOT & LOAD-TEST FLOOD SHIELD (Locust, Python Flooder, Malicious Scanners)
# ==============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Blokir langsung bot load-testing, scrapers agresif, dan scanner berbahaya
    RewriteCond %{HTTP_USER_AGENT} (locust|python-requests|aiohttp|httpx|sqlmap|nikto|havij|acunetix|nessus|nmap|masscan) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP:User-Agent} ^-?$
    RewriteRule .* - [F,L]
</IfModule>

# Block direct HTTP access to api/data directory and all CSV/sensitive database exports
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(csv|tsv)$ - [F,L]
    RewriteRule ^DPT_IAGI_2026_Publikasi - [F,L]
    RewriteRule ^api/data(/.*)?$ - [F,L]
</IfModule>

# Protect hidden files and sensitive extensions (including CSV DPT files, databases, and logs)
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|lock|json|csv|tsv|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically block direct HTTP access to any DPT publication or exported CSV
<Files "DPT_IAGI_2026_Publikasi.csv">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Enterprise Security Headers (Defense-in-depth)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable caching for dynamic dashboard files (Ensures audit logs & tally update instantly)
<FilesMatch "^(admin\.html|hasil\.html|sw\.js|manifest\.json)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# Enforce no-cache for JavaScript files in js/ folder
<FilesMatch "\.(js)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>


